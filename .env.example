# ShareBase target app (local dev surface only -- not a real system)
SHAREBASE_HOST=127.0.0.1
SHAREBASE_PORT=8080
SHAREBASE_SECRET=dev-only-not-a-real-secret

# Demo operator credentials for the ShareBase login screen.
# These exist solely to exercise the login step of the automation flow.
SHAREBASE_USER=svc_agent
SHAREBASE_PASS=Demo-Pass-1234

# Idle session lifetime in seconds. The automation must cope with expiry.
SHAREBASE_SESSION_TTL=900
